# Use Node.js version 16 as the base image  
FROM node:16  
  
# Set working directory inside the container to /client  
WORKDIR /client  
  
# Copy package.json and package-lock.json to /client to install dependencies first  
# This helps Docker cache the npm install step if dependencies don't change  
COPY package*.json /client/  
  
# Install React app dependencies inside the container  
RUN npm install  
  
# Copy all app source code into the container  
COPY . /client/  
  
# Expose port 3000 - React development server runs on this port by default  
EXPOSE 3000  
  
# Start the React development server when the container runs  
CMD ["npm", "start"]  
