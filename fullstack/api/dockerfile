# Docker is a platform that allows you to package an application and its dependencies into a lightweight, portable container.
# This container can run consistently across different environments, making it easier to develop, ship, and run applications.

# Summary of the flow
# Dockerfile  --> (docker build) -->  Image  --> (docker run) -->  Container (running instance) 

# You write a Dockerfile describing how to build your environment.
# You build an image based on that Dockerfile.
# You run a container from that image to execute your app.

# Use the official Node.js image from Docker Hub as the base image.  
FROM node  
#FROM node:16  
  
# Set the working directory inside the container to /app  
WORKDIR /app  
  
# Copy package.json and package-lock.json (if present) to the working directory  
# This is done separately to leverage Docker cache and avoid reinstalling dependencies on every build  
COPY package*.json ./  
  
# Install the dependencies defined in package.json  
RUN npm install  
  
# Copy the rest of the application code to the container  
COPY . .  
  
# Expose port 4000 to allow access to the application outside the container  
EXPOSE 4000  
  
# Define the command to run the app when the container starts  
CMD ["npm", "start"]  
